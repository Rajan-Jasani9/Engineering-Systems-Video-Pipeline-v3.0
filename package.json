    "render:series-parallel-availability": "remotion render src/index.tsx SeriesVsParallelAvailability out/series-vs-parallel-availability.mp4 --codec=h264 --audio-codec=aac",
    "render:series-parallel-availability:gpu": "remotion render src/index.tsx SeriesVsParallelAvailability out/series-vs-parallel-availability.mp4 --codec=h264 --audio-codec=aac --hardware-acceleration=if-possible --chrome-mode=chrome-for-testing --gl=angle --concurrency=50%",
    "render:load-balancing": "remotion render src/index.tsx LoadBalancing out/load-balancing.mp4 --codec=h264 --audio-codec=aac",
    "render:load-balancing:gpu": "remotion render src/index.tsx LoadBalancing out/load-balancing.mp4 --codec=h264 --audio-codec=aac --hardware-acceleration=if-possible --chrome-mode=chrome-for-testing --gl=angle --concurrency=50%",
